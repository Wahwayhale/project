{
  "name": "wechat-client",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "homepage": ".",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "axios": "^1.6.0",
    "lucide-react": "^1.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && npm run postbuild",
    "postbuild": "node -e \"const f=require('fs');const a='android/app/build/outputs/apk/debug/app-debug.apk';if(f.existsSync(a)){f.copyFileSync(a,'build/WeChat-v2.0.apk');console.log('[postbuild] APK copied')};const o='public/ota-version.json';if(f.existsSync(o)){f.copyFileSync(o,'build/ota-version.json');console.log('[postbuild] ota-version copied')}\"",
    "deploy": "gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0"
  }
}
